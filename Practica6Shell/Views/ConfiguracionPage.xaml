<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practica6Shell.Views.ConfiguracionPage"
             Title="Configuracion">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <Frame BackgroundColor="{StaticResource Primary}" 
                   CornerRadius="15" 
                   Padding="20" 
                   HasShadow="True">
                <StackLayout>
                    <Label Text="Configuracion" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Ajustes de la aplicacion" 
                           FontSize="16" 
                           TextColor="LightGray"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="20" 
                   HasShadow="True">
                <StackLayout Spacing="15">
                    
                    <Label Text="Notificaciones" 
                           FontSize="18" 
                           FontAttributes="Bold" />
                    <Switch IsToggled="True" />
                    
                    <BoxView HeightRequest="1" BackgroundColor="LightGray" />
                    
                    <Label Text="Modo Oscuro" 
                           FontSize="18" 
                           FontAttributes="Bold" />
                    <Switch IsToggled="False" />
                    
                    <BoxView HeightRequest="1" BackgroundColor="LightGray" />
                    
                    <Label Text="Idioma" 
                           FontSize="18" 
                           FontAttributes="Bold" />
                    <Picker>
                        <Picker.Items>
                            <x:String>Espanol</x:String>
                            <x:String>English</x:String>
                            <x:String>Francais</x:String>
                        </Picker.Items>
                    </Picker>
                           
                </StackLayout>
            </Frame>

            <Frame BackgroundColor="LightBlue" 
                   CornerRadius="10" 
                   Padding="15">
                <StackLayout>
                    <Label Text="Navegacion Modal" 
                           FontSize="16" 
                           FontAttributes="Bold" />
                    <Label Text="Esta pagina se abre como modal desde el menu lateral" 
                           FontSize="12" />
                    <Label Text="Se puede cerrar tocando fuera o usando el boton atras" 
                           FontSize="12" />
                </StackLayout>
            </Frame>

            <Button Text="Cerrar"
                    Clicked="OnCerrarClicked"
                    BackgroundColor="Gray"
                    TextColor="White"
                    CornerRadius="25" />

        </StackLayout>
    </ScrollView>

</ContentPage>