<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practica9.Pages.TiendaPage"
             Title="Tienda"
             BackgroundColor="#f0f0f0">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        
        <VerticalStackLayout Padding="20,15" 
                            BackgroundColor="#333"
                            Grid.Row="0"
                            Spacing="5">
            <Label Text="Tienda"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"/>
            <Label Text="Carrito de compras"
                   FontSize="12"
                   TextColor="#ccc"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="15">
                
                <Label Text="Productos:"
                       FontAttributes="Bold"
                       FontSize="16"/>
                
                <CollectionView ItemsSource="{Binding Productos}"
                               SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                        ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="10"
                                   BorderColor="#ddd"
                                   Padding="12"
                                   HasShadow="True">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Nombre}"
                                           FontAttributes="Bold"
                                           FontSize="14"/>
                                    <Label Text="{Binding Precio, StringFormat='${0:F2}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#4CAF50"/>
                                    <Button Text="Agregar"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AgregarAlCarritoCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#2196F3"
                                            TextColor="White"
                                            FontSize="12"
                                            Padding="10,8"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Tu Carrito:"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="0,15,0,0"/>

                <CollectionView ItemsSource="{Binding Carrito}"
                               SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                        ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="8"
                                   BackgroundColor="#FFF9C4"
                                   BorderColor="#FBC02D"
                                   Padding="10"
                                   HasShadow="True">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding Nombre}"
                                               FontAttributes="Bold"
                                               FontSize="12"/>
                                        <Label Text="{Binding Cantidad, StringFormat='Qty: {0}'}"
                                               FontSize="11"/>
                                    </VerticalStackLayout>
                                    <Label Text="{Binding Precio, StringFormat='${0:F2}'}"
                                           Grid.Column="1"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           VerticalTextAlignment="Center"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Frame CornerRadius="10"
                       BackgroundColor="#F3E5F5"
                       BorderColor="#9C27B0"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="Total:" FontAttributes="Bold" Grid.Column="0"/>
                            <Label Text="{Binding TotalCarrito, StringFormat='${0:F2}'}"
                                   FontAttributes="Bold"
                                   TextColor="#9C27B0"
                                   Grid.Column="1"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#ddd"/>

                        <Label Text="Descuento:" FontAttributes="Bold" FontSize="12"/>
                        <Entry Text="{Binding DescuentoAplicar}"
                               Placeholder="0"
                               Keyboard="Numeric"
                               FontSize="14"/>
                        
                        <Button Text="Aplicar Descuento"
                                Command="{Binding AplicarDescuentoCommand}"
                                BackgroundColor="#FF9800"
                                TextColor="White"
                                FontAttributes="Bold"
                                Padding="10,10"/>

                        <BoxView HeightRequest="1" Color="#ddd"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="Precio Final:" FontAttributes="Bold" Grid.Column="0"/>
                            <Label Text="{Binding PrecioFinal, StringFormat='${0:F2}'}"
                                   FontAttributes="Bold"
                                   TextColor="#4CAF50"
                                   FontSize="16"
                                   Grid.Column="1"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <Button Text="Limpiar Carrito"
                Command="{Binding LimpiarCarritoCommand}"
                BackgroundColor="#F44336"
                TextColor="White"
                FontAttributes="Bold"
                Grid.Row="2"
                Margin="15"
                Padding="15,15"/>

    </Grid>

</ContentPage>
