<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Practica3MVVM.ViewModels"
             x:Class="Practica3MVVM.Views.TasksPage"
             Title="Tareas">

  <ContentPage.BindingContext>
    <vm:TasksViewModel />
  </ContentPage.BindingContext>

  <VerticalStackLayout Padding="20" Spacing="12">

    <Label Text="Lista de tareas" FontAttributes="Bold" FontSize="20" />

    <HorizontalStackLayout Spacing="8">
      <Entry Text="{Binding NewTask, Mode=TwoWay}" Placeholder="Nueva tarea" HorizontalOptions="FillAndExpand" />
      <Button Text="Agregar" Command="{Binding AddTaskCommand}" />
    </HorizontalStackLayout>

    <CollectionView ItemsSource="{Binding Tasks}" SelectionMode="Single"
                    SelectedItem="{Binding SelectedTask, Mode=TwoWay}">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Frame Padding="10" Margin="0,4" HasShadow="False" BorderColor="#DDD" x:Name="TaskFrame">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup Name="CommonStates">
                <VisualState Name="Normal">
                  <VisualState.Setters>
                    <Setter TargetName="TaskFrame" Property="BackgroundColor" Value="White" />
                    <Setter TargetName="TaskFrame" Property="BorderColor" Value="#DDD" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState Name="Selected">
                  <VisualState.Setters>
                    <Setter TargetName="TaskFrame" Property="BackgroundColor" Value="#D0E1F9" />
                    <Setter TargetName="TaskFrame" Property="BorderColor" Value="#A0C1E8" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Label Text="{Binding .}" />
            <!-- Pista: el Binding . esta haciendo el bind hacia un tipo de dato simples como string ó int -->
            <!-- Pista2: el Binding Title no funciona porque no hay declarado un modelo que tenga esta propiedad string Title -->
            <!-- PistaFinal: Binding Title no funciona porque no tenemos ningun modelo en el proyecto. ni siquiera la carpeta models del mvvm. Esto solo sirve para situaciones muy simples y no es recomendado para aplicaciones medianas.-->
          </Frame>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

    <HorizontalStackLayout Spacing="8">
      <Button Text="Eliminar seleccionada" Command="{Binding RemoveTaskCommand}" />
      <Button Text="Vaciar" Command="{Binding ClearTasksCommand}" />
    </HorizontalStackLayout>

  </VerticalStackLayout>
</ContentPage>
